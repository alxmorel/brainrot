# Copy to .env locally. Never commit real secrets.

# Postgres - prod : 127.0.0.1 sur la VM. Local : `docker compose up -d` puis `npm run db:migrate`.
POSTGRES_PASSWORD="replace-me"
DATABASE_URL="postgresql://brainrot:replace-me@127.0.0.1:5432/brainrot"
DIRECT_URL="postgresql://brainrot:replace-me@127.0.0.1:5432/brainrot"

SESSION_SECRET="replace-with-32-plus-random-characters!!"
OPS_PASSWORD="replace-me"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Search Console - code de la balise HTML (contenu de l'attribut content)
# GOOGLE_SITE_VERIFICATION=""

# Stripe test - https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_TEE_CENTS="2490"

# Gelato - https://dashboard.gelato.com (API key + product UID par taille)
# Sans GELATO_API_KEY, l'envoi ops reste simulé.
# GELATO_API_KEY=""
# GELATO_FALLBACK_PHONE="0600000000"
# GELATO_UID_XS=""
# GELATO_UID_S=""
# GELATO_UID_M=""
# GELATO_UID_L=""
# GELATO_UID_XL=""
# Webhook tracking - Dashboard Gelato > Webhooks
# URL : https://ton-domaine/api/gelato/webhook  POST
# Events : order_item_tracking_code_updated, order_status_updated
# Auth header : Authorization = Bearer x7cO4ZzIP5KYuJ2r8PVDV9GOoU9CIpKyACjj7YeJYnnjN6WAzj
# GELATO_WEBHOOK_SECRET="x7cO4ZzIP5KYuJ2r8PVDV9GOoU9CIpKyACjj7YeJYnnjN6WAzj"
# Resend - confirmations commande
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Brainrototo <commandes@brainrototo.com>"

# Ops / commandes (MEP progressive)
# Phase 3-4 : expédition ops + email code seul → actif par défaut (markOrderAsShipped)
# Phase 6 : remboursement auto à l'annulation ops
# STRIPE_REFUND_ON_CANCEL="true"
